#!/usr/bin/env -S bun --no-env-file

import {
  access,
  cp,
  lstat,
  mkdir,
  mkdtemp,
  readdir,
  readlink,
  rename,
  rm,
  rmdir,
  stat,
  symlink,
  writeFile,
} from "node:fs/promises";
import { constants } from "node:fs";
import { homedir, tmpdir } from "node:os";
import { basename, join } from "node:path";
import { createInterface } from "node:readline/promises";

const home = process.env.HOME ?? homedir();
const claudeApp = process.env.CLAUDE_APP ?? "/Applications/Claude.app";
const claudeBin = join(claudeApp, "Contents", "MacOS", "Claude");
const applicationsDir = process.env.APPLICATIONS_DIR ?? "/Applications";
const compiler = process.env.CC ?? "cc";
const bundlePrefix = "com.anthropic.claudefordesktop";
const sharedLinks = ["agents", "CLAUDE.md", "hooks", "plugins", "settings.json", "skills", "statusline-command.js"];
let terminal;

class UserError extends Error {}

function instanceDir(name) {
  return join(home, `.claude-${name}`);
}

function userDataDir(name) {
  return join(instanceDir(name), "electron-data");
}

function bundleId(name) {
  return `${bundlePrefix}.${name}`;
}

function requireInstanceName(name) {
  if (!/^[A-Za-z0-9][A-Za-z0-9_-]*$/.test(name ?? "")) {
    throw new UserError("Instance names must use letters, numbers, underscores, and hyphens only");
  }
}

function requireDisplayName(display) {
  if (!/^[A-Za-z0-9][A-Za-z0-9 -]*$/.test(display ?? "")) {
    throw new UserError("Display names must use letters, numbers, spaces, and hyphens only");
  }
}

async function exists(path) {
  return lstat(path).then(() => true).catch(() => false);
}

async function targetExists(path) {
  return access(path, constants.F_OK).then(() => true).catch(() => false);
}

async function directoryExists(path) {
  return stat(path).then((info) => info.isDirectory()).catch(() => false);
}

async function isExecutable(path) {
  const info = await stat(path).catch(() => undefined);
  return info?.isFile() && (await access(path, constants.X_OK).then(() => true).catch(() => false));
}

function command(command, args, options = {}) {
  return Bun.spawnSync([command, ...args], { stderr: "pipe", stdout: "pipe", ...options });
}

function commandOutput(result) {
  return `${new TextDecoder().decode(result.stdout)}${new TextDecoder().decode(result.stderr)}`.trim();
}

function launch(commandName, args, environment = process.env) {
  const child = Bun.spawn([commandName, ...args], { env: environment, stderr: "ignore", stdout: "ignore" });
  child.unref();
}

async function ask(prompt) {
  terminal ??= createInterface({ input: process.stdin, output: process.stdout });
  return terminal.question(prompt);
}

async function listInstanceNames() {
  const entries = await readdir(home, { withFileTypes: true }).catch(() => []);
  const names = await Promise.all(
    entries
      .filter((entry) => entry.name.startsWith(".claude-"))
      .map(async (entry) => ((await directoryExists(join(home, entry.name))) ? entry.name.slice(".claude-".length) : "")),
  );

  return names.filter((name) => /^[A-Za-z0-9][A-Za-z0-9_-]*$/.test(name)).sort();
}

function plistValue(path, key) {
  const result = command("/usr/libexec/PlistBuddy", ["-c", `Print :${key}`, path]);
  return result.exitCode === 0 ? commandOutput(result) : "";
}

async function findWrapper(name) {
  const targetId = bundleId(name);
  const entries = await readdir(applicationsDir, { withFileTypes: true }).catch(() => []);

  for (const entry of entries) {
    if (!entry.name.endsWith(".app")) continue;
    const app = join(applicationsDir, entry.name);
    if (!(await directoryExists(app))) continue;
    if (plistValue(join(app, "Contents", "Info.plist"), "CFBundleIdentifier") === targetId) return app;
  }

  return "";
}

async function ensureSymlinks(name) {
  const directory = instanceDir(name);
  await mkdir(directory, { recursive: true });

  for (const link of sharedLinks) {
    const target = join(home, ".claude", link);
    const destination = join(directory, link);
    if (!(await targetExists(target))) {
      const destinationInfo = await lstat(destination).catch(() => undefined);
      if (destinationInfo?.isSymbolicLink() && (await readlink(destination)) === target) await rm(destination);
      console.log(`  source missing: ${target} (skipping ${link})`);
      continue;
    }

    const destinationInfo = await lstat(destination).catch(() => undefined);
    if (destinationInfo?.isSymbolicLink()) {
      if ((await readlink(destination)) === target) continue;
      console.log(`  updating ${link}`);
      await rm(destination);
    } else if (destinationInfo) {
      console.log(`  ${destination} exists and is not a symlink (skipping)`);
      continue;
    }

    await symlink(target, destination);
    console.log(`  linked ${link} -> ${target}`);
  }
}

function launchDefault() {
  console.log("Launching default Claude Desktop (unmanaged ~/.claude/)");
  launch("open", ["-n", claudeApp]);
}

async function launchInstance(name) {
  requireInstanceName(name);
  const directory = instanceDir(name);
  if (!(await directoryExists(directory))) throw new UserError(`Instance '${name}' does not exist (run: cdl new ${name})`);

  const wrapper = await findWrapper(name);
  if (wrapper) {
    console.log(`Launching via wrapper: ${wrapper}`);
    launch("open", ["-n", wrapper]);
    return;
  }

  const userData = userDataDir(name);
  await mkdir(userData, { recursive: true });
  console.log(`Launching '${name}' (no wrapper - run: cdl wrapper ${name})`);
  launch(claudeBin, [`--user-data-dir=${userData}`], { ...process.env, CLAUDE_CONFIG_DIR: directory });
}

async function newInstance(name) {
  requireInstanceName(name);
  if (name === "default") throw new UserError("'default' is reserved for the unmanaged ~/.claude/ instance (run: cdl default)");

  const directory = instanceDir(name);
  if (await directoryExists(directory)) {
    console.log(`Instance '${name}' already exists at ${directory}`);
  } else {
    console.log(`Creating instance '${name}' at ${directory}`);
    await ensureSymlinks(name);
  }

  await launchInstance(name);
}

async function deleteInstance(name) {
  requireInstanceName(name);
  const directory = instanceDir(name);
  if (!(await directoryExists(directory))) throw new UserError(`Instance '${name}' does not exist`);

  const wrapper = await findWrapper(name);
  console.log("About to delete:");
  console.log(`  - ${directory}`);
  if (wrapper) console.log(`  - ${wrapper}`);
  if ((await ask("Type 'yes' to confirm: ")).trim() !== "yes") throw new UserError("Cancelled.");

  await rm(directory, { force: true, recursive: true });
  if (wrapper) await rm(wrapper, { force: true, recursive: true });
  console.log("Deleted");
}

function claudeIsRunning() {
  const exact = command("pgrep", ["-x", "Claude"]);
  if (exact.exitCode === 0) return true;
  if (exact.exitCode !== 1) throw new UserError("Cannot determine whether Claude Desktop is running");

  const byPath = command("pgrep", ["-f", claudeBin]);
  if (byPath.exitCode === 0) return true;
  if (byPath.exitCode !== 1) throw new UserError("Cannot determine whether Claude Desktop is running");

  return false;
}

async function migrateInstance(name) {
  requireInstanceName(name);
  if (!(await directoryExists(instanceDir(name)))) throw new UserError(`Instance '${name}' does not exist`);

  const target = userDataDir(name);
  const targetInfo = await lstat(target).catch(() => undefined);
  if (targetInfo) {
    if (!targetInfo.isDirectory() || (await readdir(target)).length > 0) {
      throw new UserError(`${target} exists and is not an empty directory - refusing to overwrite`);
    }
  }
  if (claudeIsRunning()) throw new UserError("Quit Claude Desktop before migrating its user data");

  const supportDirectory = join(home, "Library", "Application Support");
  const entries = await readdir(supportDirectory, { withFileTypes: true }).catch(() => []);
  let match;
  for (const entry of entries) {
    if (!entry.name.startsWith("Claude-") || entry.name.slice("Claude-".length).toLowerCase() !== name.toLowerCase()) continue;
    if (await directoryExists(join(supportDirectory, entry.name))) {
      match = entry;
      break;
    }
  }
  if (!match) {
    console.log(`No external user-data dir found for '${name}' - nothing to migrate.`);
    return;
  }

  const source = join(supportDirectory, match.name);
  console.log(`Migrating ${source} -> ${target}`);
  if (targetInfo) await rmdir(target);
  await rename(source, target);
  console.log("Migration complete");
}

function plist(name, display) {
  return `<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key><string>claude-launcher</string>
    <key>CFBundleIdentifier</key><string>${bundleId(name)}</string>
    <key>CFBundleName</key><string>Claude ${display}</string>
    <key>CFBundleDisplayName</key><string>Claude ${display}</string>
    <key>CFBundleVersion</key><string>1.0</string>
    <key>CFBundleShortVersionString</key><string>1.0</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>LSMinimumSystemVersion</key><string>11.0</string>
    <key>CFBundleIconFile</key><string>claude-icon</string>
    <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
`;
}

function cString(value) {
  return JSON.stringify(value).replaceAll("\u2028", "\\u2028").replaceAll("\u2029", "\\u2029");
}

function wrapperArchitecture() {
  if (process.arch !== "x64") return process.arch;
  const translated = command("sysctl", ["-in", "sysctl.proc_translated"]);
  return translated.exitCode === 0 && commandOutput(translated) === "1" ? "arm64" : "x86_64";
}

async function writeWrapper(name, display) {
  const id = bundleId(name);
  const wrapper = join(applicationsDir, `Claude ${display}.app`);
  if (await directoryExists(wrapper)) {
    if (plistValue(join(wrapper, "Contents", "Info.plist"), "CFBundleIdentifier") !== id) {
      throw new UserError(`Refusing to overwrite ${wrapper} because it is not this instance's wrapper`);
    }
    if (!/^(y|yes)$/i.test((await ask(`${wrapper} exists. Overwrite? (y/N): `)).trim())) throw new UserError("Cancelled.");
  }

  const stagingRoot = await mkdtemp(join(applicationsDir, ".cdl-wrapper."));
  const stagedWrapper = join(stagingRoot, `Claude ${display}.app`);
  const stagedContents = join(stagedWrapper, "Contents");
  await mkdir(join(stagedContents, "MacOS"), { recursive: true });
  await mkdir(join(stagedContents, "Resources"), { recursive: true });
  await writeFile(join(stagedContents, "Info.plist"), plist(name, display));

  const sourceDirectory = await mkdtemp(join(tmpdir(), "cdl-launcher-"));
  const source = join(sourceDirectory, "claude-launcher.c");
  const userData = userDataDir(name);
  await writeFile(
    source,
    `#include <stdlib.h>
#include <unistd.h>
#include <sys/stat.h>
int main(void) {
    mkdir(${cString(userData)}, 0755);
    setenv("CLAUDE_CONFIG_DIR", ${cString(instanceDir(name))}, 1);
    char *args[] = { "Claude", ${cString(`--user-data-dir=${userData}`)}, NULL };
    execv(${cString(claudeBin)}, args);
    return 1;
}
`,
  );

  const compile = command(compiler, ["-arch", wrapperArchitecture(), "-O2", "-o", join(stagedContents, "MacOS", "claude-launcher"), source]);
  await rm(sourceDirectory, { force: true, recursive: true });
  if (compile.exitCode !== 0) {
    await rm(stagingRoot, { force: true, recursive: true });
    throw new UserError(`Failed to compile launcher (need Xcode Command Line Tools: xcode-select --install)\n${commandOutput(compile)}`);
  }

  const existingIcon = join(wrapper, "Contents", "Resources", "claude-icon.icns");
  const stagedIcon = join(stagedContents, "Resources", "claude-icon.icns");
  if (await exists(existingIcon)) {
    await cp(existingIcon, stagedIcon);
  } else {
    const resources = join(claudeApp, "Contents", "Resources");
    const icon = (await readdir(resources).catch(() => [])).find((entry) => entry.endsWith(".icns"));
    if (icon) await cp(join(resources, icon), stagedIcon);
  }

  let backup = "";
  try {
    if (await directoryExists(wrapper)) {
      backup = await mkdtemp(join(applicationsDir, ".cdl-previous."));
      await rmdir(backup);
      await rename(wrapper, backup);
    }
    await rename(stagedWrapper, wrapper);
    await rmdir(stagingRoot);
    if (backup) await rm(backup, { force: true, recursive: true });
  } catch (error) {
    if (backup) await rename(backup, wrapper).catch(() => {});
    await rm(stagingRoot, { force: true, recursive: true });
    throw error;
  }

  command("/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister", ["-f", wrapper]);
  console.log(`Wrapper: ${wrapper} (bundle: ${id})`);
}

async function createWrapper(name) {
  requireInstanceName(name);
  if (!(await directoryExists(instanceDir(name)))) throw new UserError(`Instance '${name}' does not exist (run: cdl new ${name})`);

  const defaultDisplay = `${name[0].toUpperCase()}${name.slice(1)}`;
  const display = (await ask(`Display name suffix (shown as 'Claude <suffix>') [${defaultDisplay}]: `)).trim() || defaultDisplay;
  requireDisplayName(display);
  await writeWrapper(name, display);
}

async function repair(name) {
  requireInstanceName(name);
  if (!(await directoryExists(instanceDir(name)))) throw new UserError(`Instance '${name}' does not exist`);

  console.log(`Repairing symlinks for '${name}'`);
  await ensureSymlinks(name);
}

async function listInstances() {
  console.log("Claude Desktop instances");
  console.log("========================");
  const names = await listInstanceNames();
  if (names.length === 0) {
    console.log("  (none - create one with: cdl new <name>)");
    return;
  }
  for (const name of names) {
    const wrapper = await findWrapper(name);
    console.log(`  ${name.padEnd(20)}  ${wrapper ? basename(wrapper) : "(no wrapper)"}`);
  }
}

async function diagnose() {
  console.log("Claude Desktop diagnostics");
  console.log("========================");
  console.log(`${await directoryExists(claudeApp) ? "present" : "missing"}: ${claudeApp}`);
  console.log(`${await isExecutable(claudeBin) ? "executable" : "not executable"}: ${claudeBin}`);
  console.log("\nInstances:");
  for (const name of await listInstanceNames()) {
    const directory = instanceDir(name);
    const userData = userDataDir(name);
    const wrapper = await findWrapper(name);
    console.log(`  ${name}`);
    console.log(`    dir:       ${directory}`);
    console.log(`    user-data: ${userData} (${(await directoryExists(userData)) ? "exists" : "created on launch"})`);
    console.log(`    wrapper:   ${wrapper || "(none)"}`);
    for (const link of sharedLinks) {
      const destination = join(directory, link);
      const info = await lstat(destination).catch(() => undefined);
      if (info?.isSymbolicLink()) {
        if (await targetExists(destination)) continue;
        console.log(`    ${link}: broken symlink`);
        continue;
      }
      console.log(`    ${link}: ${info ? "not a symlink" : "missing"}`);
    }
  }

  const supportDirectory = join(home, "Library", "Application Support");
  const external = await Promise.all(
    (await readdir(supportDirectory, { withFileTypes: true }).catch(() => []))
      .filter((entry) => entry.name.startsWith("Claude-"))
      .map(async (entry) => ((await directoryExists(join(supportDirectory, entry.name))) ? entry.name : "")),
  );
  console.log("\nExternal user-data dirs (candidates for migration):");
  const candidates = external.filter(Boolean);
  if (candidates.length === 0) console.log("  (none)");
  for (const directory of candidates) {
    const name = directory.slice("Claude-".length).toLowerCase();
    console.log(`  - ${join(supportDirectory, directory)} (cdl migrate ${name})`);
  }
}

function usage() {
  console.log(`cdl - Claude Desktop multi-instance launcher

Usage:
  cdl list                  List all instances
  cdl default               Launch the default unmanaged ~/.claude/ instance
  cdl new <name>            Create instance (with shared symlinks) and launch
  cdl <name>                Launch existing instance (shorthand for: cdl launch <name>)
  cdl launch <name>         Launch existing instance
  cdl wrapper <name>        Build /Applications/Claude <Name>.app wrapper
  cdl repair <name>         Re-sync shared symlinks from ~/.claude/
  cdl migrate <name>        Move ~/Library/Application Support/Claude-<X>/ into the instance
  cdl delete <name>         Delete instance dir (and wrapper if present)
  cdl diagnose              Show instance state and migration candidates`);
}

async function main() {
  const [commandName = "", ...args] = process.argv.slice(2);
  const allowsMissingApp = ["", "help", "-h", "--help", "list", "diagnose"].includes(commandName);
  if (!allowsMissingApp && !(await directoryExists(claudeApp))) {
    throw new UserError(`Claude.app not found at ${claudeApp}. Install it from https://claude.ai/download`);
  }

  switch (commandName) {
    case "":
    case "help":
    case "-h":
    case "--help":
      usage();
      break;
    case "list":
      await listInstances();
      break;
    case "default":
      launchDefault();
      break;
    case "new":
      await newInstance(args[0] ?? "");
      break;
    case "launch":
      if (args[0] === "default") launchDefault();
      else await launchInstance(args[0] ?? "");
      break;
    case "delete":
    case "rm":
      await deleteInstance(args[0] ?? "");
      break;
    case "wrapper":
      await createWrapper(args[0] ?? "");
      break;
    case "repair":
      await repair(args[0] ?? "");
      break;
    case "migrate":
      await migrateInstance(args[0] ?? "");
      break;
    case "diagnose":
      await diagnose();
      break;
    default:
      await launchInstance(commandName);
  }
}

try {
  await main();
} catch (error) {
  console.error(`Error: ${error instanceof Error ? error.message : error}`);
  process.exitCode = 1;
} finally {
  terminal?.close();
}
