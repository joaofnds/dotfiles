#!/usr/bin/env bun

import { $ } from "bun";
import { glob, mkdtemp, readdir, rm, stat } from "node:fs/promises";
import { homedir, tmpdir } from "node:os";
import { join } from "node:path";

// Without this a tab in a tmux -F format comes back as "_" and every row mis-parses. The bug
// hides under the real binding, which inherits a UTF-8 environment, and appears from a bare shell.
process.env.LC_ALL = "en_US.UTF-8";

const FIELDS = [
  "#{session_name}",
  "#{window_index}",
  "#{pane_index}",
  "#{pane_id}",
  "#{pane_tty}",
  "#{pane_current_path}",
  "#{pane_title}",
].join("\t");

// Basic ANSI slots only, named by role. toggle-dark-mode rewrites ghostty's theme between
// Solarized Dark and Light and reloads it, so these follow the palette; pinned hex would not.
const STYLE = {
  reset: "\x1b[0m",
  waiting: "\x1b[35m",
  busy: "\x1b[33m",
  idle: "\x1b[2m",
  origin: "\x1b[32m",
  session: "\x1b[36m",
  age: "\x1b[2m",
};

function paint(role, text) {
  return `${STYLE[role]}${text}${STYLE.reset}`;
}

// Filled against hollow against half, so the three states still read apart in grayscale.
const STATE_MARKS = {
  waiting: paint("waiting", "◐"),
  busy: paint("busy", "●"),
  idle: paint("idle", "○"),
};

// A waiting agent is blocked on you, so it sorts above everything; a busy one needs nothing
// and sinks. An unrecognised status sits between the two rather than claiming either end.
const RANKS = { waiting: 0, idle: 1, busy: 3 };
const UNRANKED = 2;

async function claudePanes() {
  const filter = "#{==:#{pane_current_command},claude}";
  const out = await $`tmux list-panes -a -f ${filter} -F ${FIELDS}`.nothrow().text();

  return out
    .split("\n")
    .filter((line) => line.length > 0)
    .map((line) => {
      const [session, window, index, id, tty, cwd, title] = line.split("\t");
      return { session, window: Number(window), index: Number(index), id, tty, cwd, title };
    })
    .sort((a, b) => a.session.localeCompare(b.session) || a.window - b.window || a.index - b.index);
}

// Each CLAUDE_CONFIG_DIR keeps its own agent list, so a session started under one store is
// invisible to the others. Verified: the runsmith pane only appears under ~/.claude-runsmith.
async function configStores() {
  const home = homedir();
  const names = await readdir(home);
  const stores = [];

  for (const name of names.filter((n) => n.startsWith(".claude"))) {
    const dir = join(home, name);
    const projects = await stat(join(dir, "projects")).catch(() => null);
    if (projects?.isDirectory()) stores.push(dir);
  }

  return stores;
}

// claude agents --json reports a pid and a live status; tmux knows each pane's tty. ps joins them.
async function agentsByTty() {
  const stores = await configStores();

  const [lists, processes] = await Promise.all([
    Promise.all(
      stores.map((dir) =>
        $`claude agents --json`
          .env({ ...process.env, CLAUDE_CONFIG_DIR: dir })
          .nothrow()
          .text()
          .then((raw) => ({ dir, raw })),
      ),
    ),
    $`ps -axo pid=,tty=`.nothrow().text(),
  ]);

  const ttys = new Map();
  for (const line of processes.split("\n")) {
    const match = line.trim().match(/^(\d+)\s+(\S+)$/);
    if (match && match[2] !== "??") ttys.set(Number(match[1]), `/dev/${match[2]}`);
  }

  const found = new Map();
  for (const { dir, raw } of lists) {
    let agents = [];
    try {
      agents = JSON.parse(raw);
    } catch {
      continue;
    }

    for (const agent of agents) {
      const tty = ttys.get(agent.pid);
      if (tty) {
        found.set(tty, { status: agent.status, pid: agent.pid, store: dir, id: agent.sessionId });
      }
    }
  }

  return found;
}

// claude agents --json carries a start time but never a last-activity one, so the transcript's
// mtime stands in for it. The path encodes the cwd in a scheme this would otherwise have to
// reproduce, so the session id is matched by glob instead. An absent file leaves the age unknown.
async function lastActivity(agent) {
  if (!agent?.id) return null;

  const projects = join(agent.store, "projects");
  for await (const match of glob(`*/${agent.id}.jsonl`, { cwd: projects })) {
    const info = await stat(join(projects, match)).catch(() => null);
    if (info) return info.mtimeMs;
  }

  return null;
}

// Minutes up to the hour, then hours: two characters carry the only question the column
// answers, which is whether this agent has been sitting there long enough to look at. Each
// unit truncates, so the figure is time definitely elapsed rather than time rounded up to.
function formatAge(mtime, now) {
  if (mtime === null) return "-";

  const minutes = Math.max(0, Math.floor((now - mtime) / 60_000));
  if (minutes < 60) return `${minutes}m`;

  const hours = Math.floor(minutes / 60);
  return hours < 24 ? `${hours}h` : `${Math.floor(hours / 24)}d`;
}

// Three values are known, waiting, idle and busy. Anything else renders as its own word rather
// than collapsing into a symbol that would hide it.
function stateMark(status) {
  if (!status) return " ";
  return STATE_MARKS[status] ?? status;
}

function abbreviate(cwd) {
  const home = process.env.HOME;
  return home && cwd.startsWith(home) ? `~${cwd.slice(home.length)}` : cwd;
}

// The conversation title is pane_title minus its leading glyph. Three values identify nothing:
// the empty string, the pre-first-prompt literal, and tmux's hostname default.
function label(pane, host) {
  const title = pane.title.replace(/^\S*\s/, "");
  const usable = title.length > 0 && title !== "Claude Code" && pane.title !== host;

  return usable ? title : abbreviate(pane.cwd);
}

async function renderPreview(paneId) {
  const height = Number(process.env.FZF_PREVIEW_LINES) || 40;
  const captured = await $`tmux capture-pane -e -p -S ${-height} -t ${paneId}`.nothrow().text();

  // capture-pane -e keeps colour escapes, so a visually blank row is not an empty string.
  const blank = (line) => line.replace(/\x1b\[[0-9;]*m/g, "").trim() === "";

  const lines = captured.split("\n");
  while (lines.length > 0 && blank(lines[lines.length - 1])) lines.pop();

  // Pad the top so a pane holding less than a windowful still lands its newest line on the
  // bottom row, the way a terminal does, instead of floating at the top of the window.
  const body = lines.slice(-height);
  const padding = Array(Math.max(0, height - body.length)).fill("");

  console.log([...padding, ...body].join("\n"));
}

async function pickPane(rows) {
  const dir = await mkdtemp(join(tmpdir(), "claude-switcher-"));
  const rowsFile = join(dir, "rows");
  const pickFile = join(dir, "pick");

  try {
    await Bun.write(rowsFile, `${rows.join("\n")}\n`);

    // Field 1 is the pane id and field 3 the agent's pid. --with-nth hides both from the list,
    // and from what fzf matches on, so anything the user should be able to search lives in
    // field 2. ctrl-x kills the agent process; the reload waits for it to leave the agent list.
    const fzf = [
      "fzf --ansi --reverse --delimiter '\\t' --with-nth 2",
      "--header 'enter: jump · ctrl-x: kill'",
      `--preview '${Bun.main} --preview {1}'`,
      "--preview-window right:65%",
      `--bind 'ctrl-x:execute-silent(kill {3})+reload(sleep 0.3; ${Bun.main} --rows)'`,
    ].join(" ");

    // fzf returns 130 on cancel and display-popup passes that straight through. Every non-zero
    // exit means nothing was chosen, and run-shell would report one as a full-pane error.
    await $`tmux display-popup -E -w 90% -h 80% ${`${fzf} <'${rowsFile}' >'${pickFile}'`}`.nothrow();

    const picked = Bun.file(pickFile);
    if (!(await picked.exists())) return "";

    return (await picked.text()).split("\t")[0].trim();
  } finally {
    await rm(dir, { recursive: true, force: true });
  }
}

async function focus(paneId) {
  const switched = await $`tmux switch-client -t ${paneId}`.nothrow();
  if (switched.exitCode === 0) return;

  // display-message runs its argument through strftime, so a bare %14 would print as 14.
  const message = `pane ${paneId.replace("%", "%%")} is gone`;
  await $`tmux display-message -d 2000 ${message}`.nothrow();
}

// Rank first so whatever is blocked on you floats up, then age ascending so the one that just
// went quiet leads its group. Session and pane order only break a tie the clock left.
function compareRows(a, b) {
  return (
    a.rank - b.rank ||
    a.age - b.age ||
    a.pane.session.localeCompare(b.pane.session) ||
    a.pane.window - b.pane.window ||
    a.pane.index - b.pane.index
  );
}

async function buildRows(origin) {
  const panes = await claudePanes();
  if (panes.length === 0) return [];

  const [host, agents] = await Promise.all([
    $`tmux display-message -p ${"#{host}"}`.nothrow().text(),
    agentsByTty(),
  ]);

  const now = Date.now();
  const mtimes = await Promise.all(panes.map((pane) => lastActivity(agents.get(pane.tty))));

  const entries = panes.map((pane, position) => {
    const agent = agents.get(pane.tty);
    const mtime = mtimes[position];

    return {
      pane,
      agent,
      mtime,
      rank: RANKS[agent?.status] ?? UNRANKED,
      age: mtime === null ? Number.POSITIVE_INFINITY : now - mtime,
    };
  });

  entries.sort(compareRows);

  const sessionWidth = Math.max(...entries.map((entry) => entry.pane.session.length));
  const ages = entries.map((entry) => formatAge(entry.mtime, now));
  const ageWidth = Math.max(...ages.map((age) => age.length));

  return entries.map((entry, position) => {
    const marker = entry.pane.id === origin ? `${paint("origin", "*")} ` : "  ";
    const state = stateMark(entry.agent?.status);
    const session = paint("session", entry.pane.session.padEnd(sessionWidth));
    const age = paint("age", ages[position].padStart(ageWidth));
    const pid = entry.agent?.pid ?? "";
    const display = `${marker}${state} ${age}  ${session}  ${label(entry.pane, host.trim())}`;

    return `${entry.pane.id}\t${display}\t${pid}`;
  });
}

const [first, second] = process.argv.slice(2);

if (first === "--preview") {
  await renderPreview(second);
} else if (first === "--rows") {
  const rows = await buildRows("");
  if (rows.length > 0) console.log(rows.join("\n"));
} else {
  const rows = await buildRows(first ?? "");

  if (rows.length === 0) {
    await $`tmux display-message -d 2000 ${"no claude sessions"}`.nothrow();
    process.exit(0);
  }

  const picked = await pickPane(rows);
  if (picked) await focus(picked);
}
