#!/usr/bin/env zsh

channels=()

cleanup() {
  tmux set-hook -uw after-split-window
  tmux set-hook -uw pane-exited
}
trap cleanup EXIT INT TERM

needs() {
  local tool
  for tool in "$@"; do
    (( $+commands[$tool] )) || return 1
  done
}

pane() {
  local channel="update_${#channels}_$$"
  channels+=("$channel")
  tmux split-window -v -d zsh -c "$1; tmux wait-for -S $channel"
}

tmux set-hook -w after-split-window 'select-layout even-vertical'
tmux set-hook -w pane-exited 'select-layout even-vertical'

needs doom && pane 'doom upgrade --force; doom sync --gc'
needs mise && pane 'mise upgrade; mise prune --yes'
needs nix chezmoi && pane 'cd ~/.config/nix; nix flake update; chezmoi add ~/.config/nix/flake.lock'
needs nvim && pane 'nvim -c "lua require(\"lazy\").update({ wait = true })" -c "qa"'
needs nvim && pane 'nvim -c "autocmd User MasonUpdateAllComplete quitall" -c "MasonUpdateAll"'
needs backrest && pane 'backrest backlogs backup'

if needs brew; then
  needs git && git -C "$(brew --repository joaofnds/tap)" pull
  brew upgrade --yes
  brew cleanup
fi

for channel in $channels; do
  tmux wait-for "$channel"
done
