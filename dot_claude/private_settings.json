{
  "effortLevel": "high",
  "model": "sonnet",
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true,
  "autoDreamEnabled": true,
  "autoMemoryEnabled": true,
  "remoteControlAtStartup": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "tui": "fullscreen",
  "theme": "auto",
  "disableBundledSkills": false,
  "disableWorkflows": true,
  "disableClaudeAiConnectors": true,
  "disableArtifact": true,
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList",
      "Bash(git branch *)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git worktree add *)",
      "EnterWorktree",
      "Agent(isolation:worktree)"
    ]
  },
  "skillOverrides": {
    "artifact-capabilities": "off",
    "artifact-design": "off",
    "claude-api": "name-only",
    "code-review": "user-invocable-only",
    "dataviz": "off",
    "fewer-permission-prompts": "user-invocable-only",
    "init": "off",
    "keybindings-help": "user-invocable-only",
    "loop": "user-invocable-only",
    "run": "off",
    "schedule": "user-invocable-only",
    "security-review": "user-invocable-only",
    "simplify": "off",
    "update-config": "off"
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline-command.js"
  },
  "enabledPlugins": {},
  "env": {
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
