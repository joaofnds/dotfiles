{
  "agentPushNotifEnabled": true,
  "allowedMcpServers": [],
  "alwaysThinkingEnabled": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoCompactEnabled": false,
  "autoContinueAtUsageLimit": false,
  "autoDreamEnabled": false,
  "autoMemoryEnabled": false,
  "autoScrollEnabled": false,
  "awaySummaryEnabled": false,
  "companyAnnouncements": [],
  "crossSessionInbound": "accept",
  "disableAgentView": false,
  "disableAllHooks": false,
  "disableArtifact": true,
  "disableAutoMode": "disable",
  "disableBundledSkills": true,
  "disableClaudeAiConnectors": true,
  "disableDeepLinkRegistration": "disable",
  "disableRemoteControl": false,
  "disableSkillShellExecution": true,
  "disableWorkflows": true,
  "effortLevel": "high",
  "emojiCompletionEnabled": false,
  "enableAllProjectMcpServers": false,
  "enabledPlugins": {},
  "env": {
    "CLAUDE_AGENT_SDK_DISABLE_BUILTIN_AGENTS": "1",
    "CLAUDE_CHROME_CLASSIFIER_FLOOR": "false",
    "CLAUDE_CODE_DISABLE_ADVISOR_TOOL": "1",
    "CLAUDE_CODE_DISABLE_BG_EXIT_HANDOFF": "1",
    "CLAUDE_CODE_DISABLE_CRON": "1",
    "CLAUDE_CODE_DISABLE_EXPLORE_PLAN_AGENTS": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1",
    "CLAUDE_CODE_DISABLE_POLICY_SKILLS": "1",
    "CLAUDE_DISABLE_ADOPT": "1",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_COST_WARNINGS": "1",
    "DISABLE_DOCTOR_COMMAND": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_EXTRA_USAGE_COMMAND": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_INSTALLATION_CHECKS": "1",
    "DISABLE_INSTALL_GITHUB_APP_COMMAND": "1",
    "DISABLE_LOGIN_COMMAND": "1",
    "DISABLE_LOGOUT_COMMAND": "1",
    "DISABLE_UPGRADE_COMMAND": "1"
  },
  "fastMode": false,
  "feedbackDrafts": "off",
  "feedbackSurveyRate": 0,
  "fileCheckpointingEnabled": true,
  "includeCoAuthoredBy": false,
  "includeGitInstructions": false,
  "inputNeededNotifEnabled": true,
  "isolatePeerMachines": true,
  "model": "sonnet",
  "outputStyle": "brief",
  "permissions": {
    "allow": [
      "mcp__claude-in-chrome"
    ],
    "defaultMode": "bypassPermissions",
    "deny": [
      "Agent(isolation:worktree)",
      "Artifact",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList",
      "DesignSync",
      "EndConversation",
      "EnterPlanMode",
      "EnterWorktree",
      "ExitPlanMode",
      "ExitWorktree",
      "LSP",
      "NotebookEdit",
      "PowerShell",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "SendFeedback",
      "ShareOnboardingGuide",
      "TodoWrite",
      "Workflow",
      "Bash(git branch *)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git worktree add *)"
    ]
  },
  "preferredNotifChannel": "notifications_disabled",
  "prefersReducedMotion": true,
  "promptSuggestionEnabled": false,
  "remoteControlAtStartup": true,
  "respondToBashCommands": false,
  "showClearContextOnPlanAccept": false,
  "showThinkingSummaries": false,
  "showTurnDuration": false,
  "skillOverrides": {
    "art-direction": "user-invocable-only",
    "artifact-capabilities": "off",
    "artifact-design": "off",
    "claude-api": "name-only",
    "code-review": "user-invocable-only",
    "dataviz": "off",
    "deep-research": "name-only",
    "fewer-permission-prompts": "user-invocable-only",
    "frontend-design": "off",
    "init": "off",
    "keybindings-help": "user-invocable-only",
    "loop": "user-invocable-only",
    "review": "user-invocable-only",
    "run": "off",
    "schedule": "user-invocable-only",
    "security-review": "user-invocable-only",
    "simplify": "off",
    "update-config": "off",
    "verify": "off"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWebFetchPreflight": true,
  "skipWorkflowUsageWarning": true,
  "spinnerTipsEnabled": false,
  "statusLine": {
    "command": "$HOME/.claude/statusline-command.js",
    "type": "command"
  },
  "switchModelsOnFlag": false,
  "syncClaudeAiSkills": false,
  "syntaxHighlightingDisabled": true,
  "terminalProgressBarEnabled": false,
  "terminalTitleFromRename": false,
  "theme": "auto",
  "tui": "fullscreen",
  "voiceEnabled": false,
  "wheelScrollAccelerationEnabled": false,
  "workflowKeywordTriggerEnabled": false,
  "worktree": {
    "bgIsolation": "none"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/brief-pass.py"
          }
        ]
      }
    ]
  }
}
