[user]
  name = João Fernandes
  email = {{ (index .hosts .chezmoi.hostname).email }}
  signingkey = ~/.ssh/id_ed25519.pub

[gpg]
  format = ssh

[format]
  signoff = true

[commit]
  gpgsign = true

[color]
  ui = true

[core]
  excludesFile = ~/.gitignore
  pager = delta

[interactive]
  diffFilter = delta --color-only

[merge]
  conflictStyle = diff3

[github]
  user = joaofnds

[diff]
  algorithm = histogram
  indentHeuristic = true
  colorMoved = default

[push]
  autoSetupRemote = true

[pull]
  rebase = true

[rebase]
  autoStash = true

[init]
  defaultBranch = main

[delta]
  navigate = true
  plus-style = "syntax #1a412b"
  minus-style = "syntax #3b3639"
  syntax-theme = "Solarized (dark)"
  true-color = always

[url "git@github.com:"]
  insteadOf = "gh:"

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[includeIf "gitdir:~/code/livefire/"]
  path = ~/.gitconfig-livefire

[includeIf "gitdir:~/code/runsmith/"]
  path = ~/.gitconfig-runsmith
