    {
      "id": 19,
      "type": "barchart",
      "title": "Spend by session length",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 9,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT\n  multiIf(requests = 1, '1 request', requests <= 10, '2-10', requests <= 50, '11-50', '51+') AS session_length,\n  sum(spend) AS \"Spend\",\n  count() AS \"Sessions\"\nFROM (\n  SELECT session_id, count() AS requests, sum(cost_usd) AS spend\n  FROM otel.api_requests WHERE $__timeFilter(ts)\n  GROUP BY session_id\n)\nGROUP BY session_length\nORDER BY min(requests)"
        }
      ],
      "options": {
        "xField": "session_length",
        "orientation": "vertical",
        "showValue": "always",
        "barWidth": 0.7,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Sessions"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.hideFrom",
                "value": {
                  "viz": true,
                  "legend": true,
                  "tooltip": false
                }
              }
            ]
          }
        ]
      },
      "description": "Sessions grouped by how many requests they made. One-request sessions are forks and headless runs that resend a whole conversation once."
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Context size through the costliest conversations",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 9,
        "y": 37,
        "w": 15,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "rawSql": "WITH top_sessions AS (\n  SELECT session_id FROM otel.api_requests WHERE $__timeFilter(ts)\n  GROUP BY session_id HAVING countIf(activity = 'Main conversation') >= 5\n  ORDER BY sum(cost_usd) DESC LIMIT 6\n)\nSELECT\n  r.ts AS time,\n  concat(r.repo, ': ', left(replaceRegexpAll(p.first_prompt, '\\\\s+', ' '), 50)) AS session,\n  r.context_tokens AS context\nFROM otel.api_requests AS r\nLEFT JOIN otel.session_first_prompts AS p USING session_id\nWHERE $__timeFilter(ts) AND session_id IN top_sessions AND activity = 'Main conversation'\nORDER BY time"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "displayName": "${__field.labels.session}",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "always",
            "pointSize": 4,
            "spanNulls": true,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "description": "Each line is one of the six costliest sessions with at least five turns, named by its first prompt. Context grows with every turn and drops after a compaction."
    },
    {
      "id": 21,
      "type": "bargauge",
      "title": "Costliest sessions",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
