      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT\n  left(replaceRegexpAll(if(p.prompt = '', '(no prompt recorded)', p.prompt), '\\\\s+', ' '), 80) AS prompt,\n  c.spend\nFROM (\n  SELECT prompt_id, sum(cost_usd) AS spend\n  FROM otel.api_requests WHERE $__timeFilter(ts)\n  GROUP BY prompt_id ORDER BY spend DESC LIMIT 10\n) AS c\nLEFT JOIN (SELECT prompt_id, any(prompt) AS prompt FROM otel.prompts GROUP BY prompt_id) AS p USING prompt_id\nORDER BY c.spend DESC"
        }
      ],
