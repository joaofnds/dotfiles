    {
      "id": 12,
      "type": "barchart",
      "title": "Spend by context size at the time of the request",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 9,
        "y": 16,
        "w": 15,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT\n  concat(toString(intDiv(context_tokens, 50000) * 50), '-', toString((intDiv(context_tokens, 50000) + 1) * 50), 'K') AS context_size,\n  sum(input_cost) AS \"Input\",\n  sum(cache_read_cost) AS \"Cache reads\",\n  sum(cache_write_cost) AS \"Cache writes\",\n  sum(output_cost) AS \"Output\",\n  sum(other_cost) AS \"Other\"\nFROM otel.api_requests\nWHERE $__timeFilter(ts)\nGROUP BY intDiv(context_tokens, 50000) AS bucket, context_size\nORDER BY bucket"
        }
      ],
      "options": {
        "xField": "context_size",
        "orientation": "vertical",
        "stacking": "normal",
        "showValue": "never",
        "barWidth": 0.8,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Input"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Cache reads"
