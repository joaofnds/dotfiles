    {
      "id": 11,
      "type": "piechart",
      "title": "Spend by token type",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 9,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT \n  sum(input_cost) AS \"Input\",\n  sum(cache_read_cost) AS \"Cache reads\",\n  sum(cache_write_cost) AS \"Cache writes\",\n  sum(output_cost) AS \"Output\",\n  sum(other_cost) AS \"Other\"\nFROM otel.api_requests WHERE $__timeFilter(ts)"
        }
      ],
      "options": {
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
