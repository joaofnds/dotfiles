            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT\n  concat(s.session_repo, ': ', left(replaceRegexpAll(if(p.first_prompt = '', '(no prompt recorded)', p.first_prompt), '\\\\s+', ' '), 60), ' (', left(s.session_id, 8), ')') AS session,\n  s.spend\nFROM (\n  SELECT session_id, any(repo) AS session_repo, sum(cost_usd) AS spend\n  FROM otel.api_requests WHERE $__timeFilter(ts)\n  GROUP BY session_id ORDER BY spend DESC LIMIT 10\n) AS s\nLEFT JOIN otel.session_first_prompts AS p USING session_id\nORDER BY s.spend DESC"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color",
        "namePlacement": "top",
        "showUnfilled": true,
