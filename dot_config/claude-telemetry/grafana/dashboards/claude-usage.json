          ],
          "fields": "",
          "values": true,
          "limit": 12
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "decimals": 2,
          "color": {
            "mode": "continuous-YlRd"
          }
        },
        "overrides": []
      },
      "description": "Named by the session's first prompt."
    },
    {
      "id": 22,
      "type": "bargauge",
      "title": "Costliest prompts",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
