          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT replaceRegexpAll(model, '^claude-|-[0-9]{8}$', '') AS model, sum(cost_usd) AS spend FROM otel.api_requests WHERE $__timeFilter(ts) GROUP BY model ORDER BY spend DESC"
