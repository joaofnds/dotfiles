{
  "terminal": {
    "font_family": "PragmataPro"
  },
  "proxy": "",
  "auto_install_extensions": {
    "catppuccin": true
  },
  "buffer_font_family": "PragmataPro",
  "buffer_font_size": 16,
  "buffer_font_weight": 400,
  "buffer_line_height": "standard",
  "cli_default_open_behavior": "existing_window",
  "collaboration_panel": {
    "button": false,
    "dock": "left"
  },
  "diff_view_style": "unified",
  "disable_ai": true,
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "format_on_save": "on",
  "formatter": "language_server",
  "git_panel": {
    "dock": "left"
  },
  "markdown_preview": {
    "font_size": 18,
    "limit_content_width": false
  },
  "outline_panel": {
    "dock": "left"
  },
  "project_panel": {
    "dock": "left"
  },
  "telemetry": {
    "anthropic_retention": false,
    "diagnostics": false,
    "metrics": false
  },
  "theme": {
    "dark": "Catppuccin Mocha",
    "light": "Catppuccin Latte",
    "mode": "system"
  },
  "ui_font_size": 16,
  "vim_mode": true
}
